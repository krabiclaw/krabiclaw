{
  "id": "/dashboard",
  "name": "Blawby",
  "short_name": "Blawby",
  "description": "Blawby dashboard",
  "start_url": "/dashboard",
  "scope": "/dashboard",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#0B0D20",
  "theme_color": "#1F2547",
  "icons": [
    {
      "src": "/platform/blawby.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/platform/blawby-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/platform/blawby-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/platform/blawby-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/platform/blawby-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
