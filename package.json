{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 nuxi build --preset=cloudflare-module && node patch.cjs && node scripts/check-generated-worker.mjs",
    "resend:product-news:sync": "node --env-file-if-exists=.env --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs scripts/sync-resend-product-news.ts",
    "ai-search:sync": "node --experimental-strip-types scripts/ai-search-sync.ts",
    "ai-search:sync:prod": "node --experimental-strip-types scripts/ai-search-sync.ts --base-url https://krabiclaw.com",
    "ai-search:status:prod": "node --experimental-strip-types scripts/ai-search-status.ts --base-url https://krabiclaw.com",
    "typecheck": "nuxi typecheck",
    "lint": "eslint . --ignore-pattern .agents/ --ignore-pattern .tmp/ --ignore-pattern '**/.tmp/' --ignore-pattern .claude/ --ignore-pattern '**/.claude/' --max-warnings=0",
    "lint:vue-sfc": "node scripts/check-vue-sfc.mjs",
    "lint:fix": "eslint . --fix --ignore-pattern '.agents/**' --ignore-pattern '.tmp/**' --ignore-pattern '**/.tmp/**' --max-warnings=0",
    "mcp:catalog": "node --experimental-strip-types scripts/check-mcp-tool-catalog.mjs",
    "mcp:catalog:write": "node --experimental-strip-types scripts/check-mcp-tool-catalog.mjs --write",
    "chatgpt:submission:check": "node --experimental-strip-types scripts/generate-chatgpt-app-submission.mjs --check",
    "chatgpt:submission:write": "node --experimental-strip-types scripts/generate-chatgpt-app-submission.mjs --write",
    "platform-locales:check": "node --experimental-strip-types scripts/check-platform-locale-catalog.ts",
    "quality": "yarn lint:data-loading && yarn cloudflare:resources && yarn lint:email-previews && yarn lint:notification-parity && yarn lint:vue-sfc && yarn platform-locales:check && yarn typecheck && yarn lint",
    "lint:data-loading": "node scripts/check-data-loading-guardrails.mjs",
    "test": "yarn test:unit && yarn test:d1 && yarn test:e2e",
    "test:unit": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs --test tests/unit/**/*.test.ts",
    "test:unit:file": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs --test",
    "test:d1": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs --test tests/integration/*-d1.test.ts",
    "test:migrations": "node --experimental-strip-types --test tests/integration/database-baseline.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test",
    "test:browser": "playwright test --project=chromium --workers=1",
    "test:e2e:tenant-rendering": "playwright test tests/e2e/tenant-rendering.spec.ts tests/e2e/tenant-client-navigation.spec.ts --project=chromium",
    "test:e2e:guest-journeys": "playwright test tests/e2e/tenant-guest-journeys.spec.ts --project=chromium --workers=1",
    "test:e2e:mcp": "playwright test tests/e2e/mcp-media.spec.ts tests/e2e/mcp-content.spec.ts tests/e2e/mcp-owner-tools.spec.ts tests/e2e/mcp-authorization.spec.ts tests/e2e/oauth-discovery.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "cloudflare:resources": "node scripts/check-cloudflare-resources.mjs",
    "dev": "nuxt dev",
    "local:setup": "yarn schema:local && yarn db:pull:local && yarn billing:test-mode --local && yarn fixtures:verify:local --local-dev",
    "billing:test-mode": "node --env-file-if-exists=.env --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs scripts/provision-test-mode-billing.ts",
    "local:actors": "node --env-file-if-exists=.env --experimental-strip-types scripts/provision-development-auth.ts",
    "local:cards": "node scripts/generate-local-social-cards.mjs",
    "dev:worker": "yarn build && yarn dev:worker:start",
    "dev:worker:start": "wrangler dev .output/server/index.mjs --env e2e --assets .output/public --port 3000 --live-reload",
    "fixtures:verify:local": "node --experimental-strip-types scripts/verify-seeded-d1.ts",
    "e2e:local:prepare": "yarn schema:local && node --env-file-if-exists=.env --experimental-strip-types scripts/reset-e2e-artifacts.ts --older-than-hours=0 && yarn fixtures:verify:local --local-dev && yarn build",
    "postinstall": "nuxt prepare",
    "schema:local": "wrangler d1 migrations apply DB --local",
    "db:generate": "drizzle-kit generate",
    "client:import": "node scripts/client-import.mjs",
    "client:onboard": "node scripts/client-onboard.mjs",
    "client:verify": "node scripts/client-verify.mjs",
    "test:mcp": "node scripts/test-mcp-oauth.mjs",
    "test:mcp:app": "node --env-file-if-exists=.env scripts/check-mcp-app-contract.mjs",
    "test:mcp:edit": "node --env-file-if-exists=.env scripts/check-mcp-edit-flow.mjs",
    "test:mcp:image": "node --env-file-if-exists=.env scripts/check-mcp-image-flow.mjs",
    "test:mcp:ops": "node --env-file-if-exists=.env scripts/check-mcp-ops-flow.mjs",
    "test:mcp:legal": "node --env-file-if-exists=.env scripts/check-mcp-legal-demo.mjs",
    "test:mcp:prod": "node scripts/test-mcp-oauth.mjs --base-url https://krabiclaw.com",
    "canary:prod": "node scripts/canary-prod.mjs",
    "canary:notifications": "node scripts/canary-notifications.mjs",
    "canary:status": "node scripts/canary-provider-status.mjs",
    "lint:migrations": "node scripts/lint-migrations.mjs && drizzle-kit check",
    "lint:schema-drift": "node scripts/check-schema-drift.mjs",
    "audit:media-placements": "node scripts/audit-orphaned-media-placements.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "stripe:catalog:plan": "node scripts/seed-stripe.mjs --dry-run",
    "stripe:catalog:apply": "node scripts/seed-stripe.mjs --apply",
    "perf:lighthouse": "node scripts/lighthouse-check.mjs",
    "db:pull:local": "node --experimental-strip-types scripts/pull-production-snapshot.ts --local",
    "db:pull:staging": "node --experimental-strip-types scripts/pull-production-snapshot.ts --staging",
    "lint:email-previews": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs scripts/check-email-previews.ts",
    "lint:notification-parity": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs scripts/check-notification-parity.ts"
  },
  "//resolutions": "kysely pinned to 0.28.17: @better-auth/kysely-adapter (bundled transitively by better-auth even though this app only uses drizzleAdapter) imports DEFAULT_MIGRATION_TABLE from the top-level kysely package, which kysely 0.29.x stopped re-exporting from its main barrel. That breaks yarn build's Nitro/Rollup bundling pass. Remove this pin once better-auth's kysely-adapter fixes its import path or drops the kysely dependency. nitro is pinned to the exact version its Yarn patch (patches/nitro-npm-*.patch: the Cloudflare email handler returns the hook's promise so Email Routing sees failures and setReject) was written against; a Nuxt upgrade that needs a newer nitro must regenerate the patch with `yarn patch nitro`. env-runner is patched (patches/env-runner-npm-*.patch) so Nitro's dev server shuts each replaced worker thread down through the worker's own `shutdown` message instead of terminating it: terminating skipped the app's close hooks, so every rebuild left a Wrangler platform proxy running on the local D1 file until they collided with SQLITE_BUSY. Upstream 0.3.4 still terminates directly; regenerate with `yarn patch env-runner` when Nitro moves to a newer env-runner. reka-ui 2.10.4 is patched (2.10.3 had the same code) because its DOM-query aria-label caches raw values during detached drawer mount; native and caller-provided labels own naming. Regenerate or remove the patch when upgrading to an upstream version that fixes this behavior.",
  "resolutions": {
    "kysely": "0.28.17",
    "nitro": "patch:nitro@npm%3A3.0.260610-beta#~/patches/nitro-npm-3.0.260610-beta.patch",
    "@nuxt/fonts@npm:^0.14.0": "patch:@nuxt/fonts@npm%3A0.14.0#~/patches/nuxt-fonts-npm-0.14.0.patch",
    "env-runner@npm:^0.1.12": "patch:env-runner@npm%3A0.1.16#~/patches/env-runner-npm-0.1.16.patch",
    "reka-ui@npm:2.10.4": "patch:reka-ui@npm%3A2.10.4#~/patches/reka-ui-npm-2.10.4.patch"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  },
