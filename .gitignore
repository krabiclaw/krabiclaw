/.claude/worktrees/
.codex/*
!.codex/config.toml
!.codex/hooks/
!.codex/hooks/block_prod_krabiclaw.py

# Playwright browser binaries (installed locally, not committed)
.playwright/

# Local env files
.env
.env.*
!.env.example
# Older checkouts may still have this secret file; migrate its values into .env.
.dev.vars*

# Prod data backups (contain auth tokens — never commit)
prod-backup-*.sql

# Legacy admin archive (exclude from compilation)
archive/

# Client import manifests and generated seed previews (review locally, don't commit)
client-imports/
seeds/*.sql
.lighthouseci/*

.wrangler/state/v3

.scratch/
.tmp/
.valo/
tsconfig.spot.json

# Generated at build from the resolved route table (see nuxt.config.ts).
.nuxt-generated/

