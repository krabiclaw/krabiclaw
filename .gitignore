# Misc
.DS_Store
.fleet
.idea
curl_output.html

# Root scratch files from ad hoc debugging sessions — never commit
cookies.txt
pr_body.txt
*.tmp.mjs
/screenshot*.mjs
/watch-*.mjs

# AI tool local state (like .claude/ — never commit)
/.agents/skills/*
!/.agents/skills/krabiclaw-marketing/
/.agents/skills/krabiclaw-marketing/*
!/.agents/skills/krabiclaw-marketing/SKILL.md
!/.agents/skills/write-help-docs/
!/.agents/skills/krabiclaw-publishing/
